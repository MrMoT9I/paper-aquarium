# Зависимостей у сервера нет, ставить нечего — образ это просто node и код.
FROM node:22-alpine

WORKDIR /app
COPY . .

# Аквариумы пишутся в /app/data — том монтируется снаружи, владелец должен
# совпадать с пользователем контейнера (uid 1000), иначе запись не пройдёт.
RUN mkdir -p data && chown -R node:node /app
USER node

ENV PORT=8000
EXPOSE 8000

# Healthcheck дёргает главную: сервер без зависимостей, падать ему негде,
# но перезапуск при зависшем процессе лишним не бывает.
#
# Форма списком, а не строкой, — не косметика. Строку docker отдаёт шеллу,
# тот форкает wget и ждёт его; при таймауте docker убивает только шелл,
# а wget остаётся сиротой и переезжает к PID 1. Если там неподходящий
# процесс, он сироту не подберёт, и каждый такой таймаут оставляет зомби
# навсегда. Списком шелла нет вовсе: healthcheck — это сам wget, и убивают
# именно его. «|| exit 1» тоже лишний: ненулевой код docker и так считает
# провалом.
#
# Таймаут с запасом: на загруженной машине один только запуск docker exec
# занимает секунды, и пяти на всё про всё не хватало. Интервал минута —
# вдвое меньше exec-ов на сервере, где их и так сорок семь контейнеров.
HEALTHCHECK --interval=60s --timeout=20s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "-T", "10", "http://127.0.0.1:8000/"]

CMD ["node", "server.js"]
